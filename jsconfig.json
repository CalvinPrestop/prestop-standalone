{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "esnext",
      "dom"
    ],
    "target": "esnext",
    "checkJs": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [],
    "noEmit": true
  },
  "include": [
    "src/pages/**/*.jsx",
    "src/components/kiosk/**/*.jsx",
    "src/screens/**/*.jsx",
    "src/context/**/*.jsx",
    "src/hooks/**/*.js",
    "src/i18n/**/*.jsx",
    "src/i18n/**/*.js",
    "src/services/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/vite-plugins",
    "src/components/ui",
    "src/api",
    "src/lib"
  ]
}
